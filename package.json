{
  "name": "kindle-manager",
  "version": "0.2.0",
  "description": "Manage and organize your Kindle library",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "download-model": "node scripts/download-model.mjs",
    "update-homebrew": "tsx scripts/update-homebrew.mts",
    "release": "tsx scripts/release.mts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.6.2",
    "fs-extra": "^11.3.3",
    "i18next": "25.8.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "16.5.4",
    "systeminformation": "^5.31.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.3.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.kindleorganizer.app",
    "productName": "Kindle Organizer",
    "artifactName": "Kindle-Organizer-${version}-${arch}.${ext}",
    "npmRebuild": true,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "out",
      "node_modules",
      "!**/node_modules/onnxruntime-node/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@xenova/**",
      "!**/node_modules/sharp/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icons/512x512.png"
    }
  }
}
