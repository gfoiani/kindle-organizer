{
  "name": "kindle-manager",
  "version": "0.4.0",
  "description": "Manage and organize your Kindle library",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "fix-electron": "node node_modules/electron/install.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "download-model": "node scripts/download-model.mjs",
    "update-homebrew": "tsx scripts/update-homebrew.mts",
    "release": "tsx scripts/release.mts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.6",
    "@xenova/transformers": "2.17.2",
    "better-sqlite3": "12.11.1",
    "fast-xml-parser": "^5.10.1",
    "fs-extra": "11.3.6",
    "i18next": "26.3.6",
    "node-stream-zip": "^1.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.10",
    "systeminformation": "5.32.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-icon-builder": "2.0.1",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "@electron/rebuild/node-abi": "4.33.0"
  },
  "build": {
    "appId": "com.kindleorganizer.app",
    "productName": "Kindle Organizer",
    "artifactName": "Kindle-Organizer-${version}-${arch}.${ext}",
    "npmRebuild": true,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "files": [
      "out",
      "node_modules",
      "!**/node_modules/onnxruntime-node/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@xenova/**",
      "!**/node_modules/sharp/**",
      "!**/node_modules/better-sqlite3/bin/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icons/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icons/512x512.png"
    }
  }
}
