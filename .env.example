# .env.example
# Homebrew Update Script Configuration

# Optional: Set a specific path to the built/downloaded DMG file.
# Defaults to searching in ./release/*.dmg
# IMPORTANT: for a Homebrew release this must be the DMG from the GitHub
# Release (built by CI), not a local build — otherwise the SHA-256 won't match.
# DMG_FILE=/path/to/Kindle.Organizer-0.1.2-universal.dmg

# Optional: Path to the Homebrew tap repo (gfoiani/homebrew-kindle-organizer).
# Defaults to ../homebrew (sibling checkout next to this app folder).
# HOMEBREW_DIR=/path/to/homebrew-kindle-organizer
