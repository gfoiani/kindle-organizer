# .env.example
# Homebrew Update Script Configuration

# Optional: Set a specific path to the built DMG file
# Defaults to searching in ./release/*.dmg
# DMG_FILE=/path/to/release/Kindle Manager-0.1.1.dmg

# Optional: Set a specific path to the homebrew repository directory
# Defaults to "homebrew" inside the app folder
# HOMEBREW_DIR=/path/to/homebrew-kindle-organizer
